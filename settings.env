# Copy to config/settings.env and chmod 600.

RECONFORGE_HOME=.
DATABASE_PATH=output/reconforge.sqlite3

LOG_LEVEL=INFO
QUIET_MODE=true

ALLOW_ACTIVE_SCANNING=false
ALLOW_PERSON_TARGETS=false

DEFAULT_REQUESTS_PER_MINUTE=6
DEFAULT_MAX_REQUESTS_PER_RUN=100

# Optional passive OSINT integrations.
# Never commit real API keys.

RECONFORGE_SEARCH_PROVIDER=
BRAVE_SEARCH_API_KEY=
SERPAPI_API_KEY=
GITHUB_TOKEN=
